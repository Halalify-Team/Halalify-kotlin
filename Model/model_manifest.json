{
  "schema_version": 1,
  "model_id": "halalify-gender-detector-v3-full-int8-split-output",
  "model_file": "halalify_gender_v3_full_int8.tflite",
  "format": "tflite",
  "version": "3.0.0",
  "size_bytes": 3292400,
  "sha256": "65E2B0BE46BC7E865EEDD2E084E6FC8CCB4258C81213A3EBE1D8333218A503B0",
  "input": {
    "name": "images",
    "shape": [1, 416, 416, 3],
    "layout": "NHWC",
    "data_type": "int8",
    "color_space": "RGB",
    "normalization": {
      "formula": "value / 255.0",
      "range": [0.0, 1.0]
    },
    "quantization": {
      "scale": 0.003921568859368563,
      "zero_point": -128,
      "source_data_type": "float32"
    },
    "resize": {
      "strategy": "aspect_fit_letterbox",
      "width": 416,
      "height": 416,
      "pad_rgb": [114, 114, 114],
      "interpolation": "bilinear",
      "alignment": "center"
    }
  },
  "output": {
    "name": "split_box_and_confidence",
    "shape": [1, 7, 3549],
    "layout": "split_channels_first_candidates",
    "data_type": "int8",
    "branches": [
      {"name": "boxes", "shape": [1, 4, 3549], "channels": ["center_x", "center_y", "width", "height"]},
      {"name": "scores", "shape": [1, 3, 3549], "channels": ["class_a", "class_b", "class_c"]}
    ],
    "dequantized_data_type": "float32",
    "channels": ["center_x", "center_y", "width", "height", "class_a", "class_b", "class_c"],
    "box_encoding": "cxcywh",
    "coordinate_mode": "legacy_auto_normalized_or_pixels"
  },
  "quantization": {
    "method": "post_training_full_integer_internal",
    "weights": "int8_per_channel",
    "activations": "int8",
    "io_boundary": "int8",
    "output_strategy": "independent_box_and_confidence_dequantization_before_concat"
  },
  "classes": [
    {"id": 0, "label": "a", "meaning": "female", "blur_eligible": true},
    {"id": 1, "label": "b", "meaning": "male", "blur_eligible": true},
    {"id": 2, "label": "c", "meaning": "ignored", "blur_eligible": false}
  ],
  "postprocess": {
    "initial_confidence_threshold": 0.25,
    "requires_threshold_calibration": true,
    "iou_threshold": 0.5,
    "class_agnostic_nms": true,
    "max_detections": 100
  }
}
